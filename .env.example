API_PORT=4000
PORT=3000
ADMIN_EMAIL=admin@example.com
# Set a unique password of at least 12 characters before running npm run admin:create
ADMIN_PASSWORD=
# Enable secure cookies when serving over HTTPS
SECURE_COOKIES=false

# Credit/debit card checkout (optional; COD is always available)
# Use the exact public storefront origin. Local testing may use http://localhost:3000.
PUBLIC_SITE_URL=http://localhost:3000
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Order confirmation email (Nodemailer SMTP)
# Gmail: smtp.gmail.com, port 465, secure true, Gmail App Password.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Verified sender email only, e.g. orders@your-domain.com
SMTP_FROM=
# Optional shop inbox receiving a separate new-order email
ORDER_NOTIFICATION_EMAIL=

# WhatsApp order confirmations (Meta Business Cloud API; not SMTP)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Set to the supported Graph API version in your Meta app, e.g. v25.0
WHATSAPP_API_VERSION=
WHATSAPP_ORDER_TEMPLATE=
WHATSAPP_TEMPLATE_LANGUAGE=en
