{
  "name": "powerplanet-store",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "next dev --hostname 0.0.0.0",
    "dev:api": "node --watch server/index.mjs",
    "build": "next build",
    "start": "node scripts/start.mjs",
    "start:api": "node server/index.mjs",
    "diagnose:api": "node scripts/diagnose-api.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "node tests/browser.mjs",
    "admin:create": "node scripts/create-admin.mjs",
    "setup": "node scripts/setup.mjs",
    "catalog:collect": "node scripts/catalog/collect.mjs",
    "catalog:enrich": "node scripts/catalog/enrich.mjs",
    "catalog:import": "node scripts/catalog/import.mjs",
    "test:catalog-browser": "node tests/catalog-browser.mjs",
    "test:payments-browser": "node tests/payments-browser.mjs",
    "test:homepage-browser": "node tests/homepage-browser.mjs",
    "format": "prettier --write \"components/**/*.jsx\" \"app/**/*.{jsx,css}\"",
    "format:check": "prettier --check \"components/**/*.jsx\" \"app/**/*.{jsx,css}\""
  },
  "dependencies": {
    "express": "^5.1.0",
    "express-rate-limit": "^8.2.1",
    "helmet": "^8.1.0",
    "lucide-react": "^0.468.0",
    "next": "^16.2.1",
    "nodemailer": "^10.0.12",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "stripe": "^22.6.2",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "cheerio": "^1.2.0",
    "prettier": "3.8.1",
    "sharp": "^0.35.5",
    "typescript": "^5.9.3"
  }
}
